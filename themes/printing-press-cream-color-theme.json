  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6F6E69",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#66800B"
      }
    },
    {
      "name": "String regexp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#24837B"
      }
    },
    {
      "name": "Number & constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#BC5215"
      }
    },
    {
      "name": "Keyword & storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#5E409D"
      }
    },
    {
      "name": "Keyword operator word",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#5E409D"
      }
    },
    {
      "name": "Type & class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.enum",
        "support.type",
        "entity.name.namespace",
        "support.class"
      ],
      "settings": {
        "foreground": "#AD8301"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#205EA6"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#24837B"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#24837B"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#AF3029"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#6D675F"
      }
    },
    {
      "name": "Attribute name",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#AD8301"
      }
    },
    {
      "name": "Punctuation separators",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "meta.separator"
      ],
      "settings": {
        "foreground": "#6D675F"
      }
    },
    {
      "name": "Decorator & macro",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "support.function.macro",
        "entity.name.macro"
      ],
      "settings": {
        "foreground": "#A02F6F"
      }
    },
    {
      "name": "Library / built-in variable",
      "scope": [
        "support.variable",
        "variable.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#A02F6F"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#AF3029",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#6D675F",
        "fontStyle": "italic strikethrough"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted.diff",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#66800B"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted.diff",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#AF3029"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed.diff"
      ],
      "settings": {
        "foreground": "#AD8301"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#AD8301",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#BC5215",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#5E409D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#6D675F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#205EA6"
      }
    },
    {
      "name": "Markdown raw code",
      "scope": [
        "markup.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#BC5215"
      }
    },
    {
      "name": "Markdown list marker",
      "scope": [
        "markup.list punctuation.definition.list",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#BC5215"
      }
    },
    {
      "name": "JSON key",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.key.json"
      ],
      "settings": {
        "foreground": "#24837B"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "meta.property-literal.css"
      ],
      "settings": {
        "foreground": "#24837B"
      }
    },
    {
      "name": "CSS value constant",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color.css"
      ],
      "settings": {
        "foreground": "#BC5215"
      }
    },
    {
      "name": "YAML key",
      "scope": [
        "entity.name.tag.yaml",
        "meta.mapping.key.yaml"
      ],
      "settings": {
        "foreground": "#24837B"
      }
    }
  ],
  "semanticTokenColors": {
    "type": "#AD8301",
    "class": "#AD8301",
    "interface": "#AD8301",
    "enum": "#AD8301",
    "typeParameter": "#AD8301",
    "namespace": "#AD8301",
    "function": "#205EA6",
    "method": "#205EA6",
    "property": "#24837B",
    "parameter": "#24837B",
    "enumMember": "#BC5215",
    "event": "#A02F6F",
    "macro": "#A02F6F",
    "decorator": "#A02F6F"
  }
}